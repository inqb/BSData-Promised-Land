        <profile name="The Vespertide Scythe" typeId="2857-5ab3-db0f-64a1" typeName="Melee Weapon" hidden="false" id="5a96-0f88-e455-8239">
          <characteristics>
            <characteristic name="Dice" typeId="e736-f6b3-0474-ddb8">3</characteristic>
            <characteristic name="Strength" typeId="9a62-cd45-d844-0bc3">+5</characteristic>
            <characteristic name="Damage" typeId="2780-b560-1641-b9a5">7</characteristic>
            <characteristic name="Traits" typeId="1977-0f4d-9e75-2e2d">This weapon inflicts Critical Hits on natural attack rolls on a 7+ if its target is a *Dæmon*. Health points lost in excess of a model’s Health characteristic as a result of attacks with this weapon are not discarded, but instead allocated to the next model in the unit.
Each time a unit is destroyed by this weapon, enemy units within 6” of its bearer gain one attrition point.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Auri" typeId="cost-auri" value="325"/>
      </costs>
      <rules>
        <rule name="Knight-Imperatrix of the Ouresan Hosts - Aura (12”)" id="262e-e3b0-21ee-f628" hidden="false">
          <description>Friendly *Castellan Legion* units within 12” of this unit may reroll failed attrition rolls.</description>
        </rule>
      </rules>
