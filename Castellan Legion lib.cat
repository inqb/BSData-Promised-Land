      <rules>
        <rule name="The Angel of Vengeance" id="ff42-94aa-cace-08d6" hidden="false">
          <description>This unit’s charge distance is a maximum of 14 instead of 10, and can may reroll one or both of its dice when determining its charge distance. This unit has advantage with its melee attacks in any turn in which it makes a successful charge.</description>
        </rule>
      </rules>
