          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Dance of Death" hidden="false" id="1767-64a6-3a33-2f23">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7215-dbca-d91e-eac3"/>
          </constraints>
          <rules>
            <rule name="Dance of Death" id="52bc-2498-1401-75fd" hidden="false">
              <description>This unit can move over *infantry* units when it makes a charge move (as long as its model can be placed on the battlefield at the end of that move). If a charge move made by this unit moves over or within the control range of any enemy units other than its charge target, it can make a single attack roll using the profile of one of its melee weapons against each of those units.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Dextrous Strikes" hidden="false" id="0f6a-f219-3a60-9d3f">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a652-7d57-8627-c904"/>
          </constraints>
          <rules>
            <rule name="Dextrous Strikes" id="de06-f8e3-5a9a-3802" hidden="false">
              <description>Add 1 to this unit’s melee attack rolls.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Divine Consecration" hidden="false" id="dcb5-3a32-5458-74b9">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4352-97ba-f554-0d8c"/>
          </constraints>
          <rules>
            <rule name="Divine Consecration" id="ab03-c166-3f00-f4df" hidden="false">
              <description>This unit is *core*.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Graceful Advance" hidden="false" id="a9c0-d761-c8dd-70dd">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d4c0-f80a-96ce-c3cd"/>
          </constraints>
          <rules>
            <rule name="Graceful Advance" id="f329-c088-9f34-7b4b" hidden="false">
              <description>When this unit makes an advance move, it can move up to its full Speed characteristic instead of only half.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Legendary Warrior" hidden="false" id="82e8-7787-76fc-7388">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5ea8-e06f-b861-6c4f"/>
          </constraints>
          <rules>
            <rule name="Legendary Warrior" id="0bca-6832-1844-c77d" hidden="false">
              <description>Friendly units and *ally* units within 6” of this unit may add 1 to their attrition rolls.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Primordial Runes" hidden="false" id="ce72-fba9-d4e8-d33e">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="efab-b1e7-fd17-7a97"/>
          </constraints>
          <rules>
            <rule name="Primordial Runes" id="95fb-1441-161d-295d" hidden="false">
              <description>Each time this unit is the target of a *curse*, roll a dice. On a roll of 6+, that invocation has no effect on this unit.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Shroud of Silence" hidden="false" id="6a57-d286-fb74-6b6a">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1b47-fefa-1be4-84c8"/>
          </constraints>
          <rules>
            <rule name="Shroud of Silence" id="e7f1-1459-8582-e1ea" hidden="false">
              <description>*Dæmon* units may not make reactions to this unit.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Soul Guidance" hidden="false" id="86e1-3cd9-1919-eae7">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fd0d-762e-b6ec-27bf"/>
          </constraints>
          <rules>
            <rule name="Soul Guidance" id="5938-9724-e09e-d290" hidden="false">
              <description>Successful hits made by this model can be allocated to models in a target unit by the attacking player, rather than by the target unit’s controlling player (even if models in that unit are already injured). Such attacks can also be allocated to *independent* units in a group, even if there are three or models in its retinue.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
  <sharedInfoGroups>
    <infoGroup name="Rites of Radiance" id="96b7-1f2f-b4c1-99ff" hidden="false">
      <profiles>
        <profile name="Illumination" typeId="profile-invocation" typeName="Invocation" hidden="false" id="2821-4f62-8fde-6cc2">
          <characteristics>
            <characteristic name="Arcane Value" typeId="char-arc-val">7 - *Elemental*, *Divine**</characteristic>
            <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select a visible enemy unit within 24” of the invoking unit. Whenever a friendly unit targets this unit, their attack rolls ignore all negative modifiers, and that unit does not benefit from cover.</characteristic>
            <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit gains one attrition point.</characteristic>
          </characteristics>
        </profile>
        <profile name="Starlit Maelstorm" typeId="profile-invocation" typeName="Invocation" hidden="false" id="6097-02ac-fa6d-11fa">
          <characteristics>
            <characteristic name="Arcane Value" typeId="char-arc-val">9 - *Curse*, *Divine**</characteristic>
            <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">This invocation is a *psychic* *blast* attack, with a 3” radius originating from a visible point within 18” of the invoking unit, with a strength characteristic of +3 and a damage of 2.</characteristic>
            <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit immediately gains two attrition points.</characteristic>
          </characteristics>
        </profile>
        <profile name="Blinding Light" typeId="profile-invocation" typeName="Invocation" hidden="false" id="aeed-3b06-6414-edc1">
          <characteristics>
            <characteristic name="Arcane Value" typeId="char-arc-val">9 - *Curse*, *Divine**</characteristic>
            <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Enemy *infantry* units within 6” of the invoking unit are blinded by light, and can either choose to witness angelic horrors or shield their eyes. Witnesses lose D5 health, and those who shield their eyes cannot take reactions during this turn.</characteristic>
            <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit immediately gains two attrition points.</characteristic>
          </characteristics>
        </profile>
        <profile name="Blessed Blades" typeId="profile-invocation" typeName="Invocation" hidden="false" id="9270-673e-0719-13e2">
          <characteristics>
            <characteristic name="Arcane Value" typeId="char-arc-val">10 - *Blessing*, *Divine**</characteristic>
            <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">This unit has advantage on attack rolls made with its melee weapons.</characteristic>
            <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">This unit has disadvantage on attack rolls made with melee weapons</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
  </sharedInfoGroups>
  <rules>
    <rule name="Celestial Magic" id="936e-0357-d6d3-e075" hidden="false">
      <alias>Divine</alias>
      <description>When a *Dæmon* *mystic* makes a counterspell reaction against a *Divine* invocations, it halves its Arcane characteristic (rounding up).</description>
    </rule>
  </rules>
</catalogue>
