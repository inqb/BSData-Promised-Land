            <characteristic name="Traits" typeId="1977-0f4d-9e75-2e2d">Each time a unit gains an attrition point as part of an attack that includes this weapon, it gains one additional attrition point.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wildfire" typeId="f94b-6526-ad27-3051" typeName="Ranged Weapon" hidden="false" id="prof-wildfire-local">
          <characteristics>
            <characteristic name="Range" typeId="1023-f0db-ffcf-da31">18&quot;</characteristic>
            <characteristic name="Dice" typeId="1192-2222-5926-5b4b">D5+5</characteristic>
            <characteristic name="Strength" typeId="ff5b-347b-c7f0-5770">+3</characteristic>
            <characteristic name="Damage" typeId="a482-225f-a3cb-a700">2</characteristic>
            <characteristic name="Traits" typeId="76cd-5882-86da-52cf">Attacks made with this weapon count as *psychic* attacks, and units do not benefit from cover when being targeted by this weapon. Each time a unit gains an attrition point as part of an attack that includes this weapon, it gains one additional attrition point.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wildfire" typeId="profile-invocation" typeName="Invocation" hidden="false" id="inv-wildfire">
          <characteristics>
            <characteristic name="Arcane Value" typeId="char-arc-val">8 - Blessing</characteristic>
            <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Until the end of the turn, this unit has advantage on all of its attack rolls. In addition, one model in this unit is equipped with the Wildfire weapon until the end of the turn.</characteristic>
            <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">If this invocation misfires, the invoking unit immediately gains 2 attrition points.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Spirit of Fire" id="rule-spirit-of-fire" hidden="false">
          <description>This unit is immune to the effects of any weapons and abilities with the words ‘fire’, ‘inferno’, ‘blaze’ and ‘incinerate’ (or derivatives of those words) in their names, and attack rolls made as part of the Redemption in Death ability are made with disadvantage.
In addition, this unit knows the following invocations:</description>
        </rule>
        <rule name="Sweeping Inferno" id="rule-sweeping-inferno" hidden="false">
          <description>When this unit is makes a Fight action, its models can either attack with their pyrestave, or the unit can create an inferno.
If it creates an inferno, it makes a *blast* attack, originating from a model in this unit of the attacking player’s choice with a 3” blast radius, with a strength characteristic of +2 and a damage of 1. Each time a unit gains an attrition point as part of an inferno attack, it gains one additional attrition point.</description>
        </rule>
      </rules>
