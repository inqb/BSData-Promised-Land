        <characteristic name="Damage" typeId="2780-b560-1641-b9a5">3</characteristic>
        <characteristic name="Traits" typeId="1977-0f4d-9e75-2e2d">Models equipped with this weapon halve their initiative characteristic.
When this weapon targets an *independent infantry* or *monster* unit, it has a damage characteristic of 6.</characteristic>
      </characteristics>
    </profile>
    <profile name="Heavy Maul" typeId="2857-5ab3-db0f-64a1" typeName="Melee Weapon" hidden="false" id="2c07-20c6-e268-fdce">
