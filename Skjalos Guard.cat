        <profile name="Sykaran Longrifle" typeId="f94b-6526-ad27-3051" typeName="Ranged Weapon" hidden="false" id="prof-sykaran-longrifle">
          <characteristics>
            <characteristic name="Range" typeId="1023-f0db-ffcf-da31">60&quot;</characteristic>
