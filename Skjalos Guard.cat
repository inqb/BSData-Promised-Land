    </profile>
    <profile name="Bladed Tail" typeId="2857-5ab3-db0f-64a1" typeName="Melee Weapon" hidden="false" id="7c0f-9771-4548-f3bd">
      <characteristics>
        <characteristic name="Dice" typeId="e736-f6b3-0474-ddb8">D5</characteristic>
