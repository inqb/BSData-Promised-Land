      <rules>
        <rule name="Blood Ritualist" id="3ecc-98f5-6df8-f927" hidden="false">
          <description>A group including this unit may roll an additional dice when determining its charge distance, discarding the lowest dice.
If a group including this unit destroys its charge target in the same turn in which it successfully charged it, any attrition points allocated to units within this group are immediately removed.</description>
        </rule>
      </rules>
