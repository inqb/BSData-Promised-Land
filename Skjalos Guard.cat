    <profile name="Siege Shield" typeId="0c1d-fb59-db29-3959" typeName="Other Wargear" hidden="false" id="7820-91d9-1031-ee63">
      <characteristics>
        <characteristic name="Traits" typeId="e990-df09-ac6b-7481">Melee attacks with a strength of +3 or greater that target a unit with a siege shield have disadvantage. This has no effect on *destroyer* or *psychic* attacks, or any attacks made by *leviathan* units.</characteristic>
      </characteristics>
    </profile>
