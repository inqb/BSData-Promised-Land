                      <profiles>
                        <profile name="Skysplinter Siege Blade" typeId="2857-5ab3-db0f-64a1" typeName="Melee Weapon" hidden="false" id="0749-a0a7-698c-36a4">
                          <characteristics>
                            <characteristic name="Dice" typeId="e736-f6b3-0474-ddb8">D10+10</characteristic>
                            <characteristic name="Strength" typeId="9a62-cd45-d844-0bc3">+3</characteristic>
                            <characteristic name="Damage" typeId="2780-b560-1641-b9a5">3</characteristic>
                            <characteristic name="Traits" typeId="1977-0f4d-9e75-2e2d">Units equipped with this weapon can move through terrain features less than 3” tall, and have a strength characteristic of +5 and a damage characteristic of 8 when targeting *structures*. *Trap* abilities have no effect if they were triggered by a unit equipped with this weapon.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                      <costs>
                        <cost name="Auri" typeId="cost-auri" value="40"/>
                      </costs>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
              </selectionEntryGroups>
              <costs>
                <cost name="Auri" typeId="cost-auri" value="125"/>
              </costs>
              <rules>
                <rule name="Quad-Skaryssan Tracks" id="e1c3-7b91-e18f-24d4" hidden="false">
                  <description>A unit equipped with Quad-Skaryssan Tracks has a Speed characteristic of 8. Each time it is activated during the Movement Phase, this unit can be rotated up to a maximum of 45° clockwise or anti-clockwise.
A unit equipped with Quad-Skaryssan Tracks cannot make a Fight action unless it is the last unit its controlling player is eligible to activate.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" value="8" field="char-speed" scope="parent" affects="profiles.Unit"/>
              </modifiers>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
