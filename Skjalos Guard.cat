      <rules>
        <rule name="Hold Your Ground - Aura (5”)" id="b719-47b5-61c2-8adf" hidden="false">
          <description>While this unit is wholly within its controlling player’s deployment zone or within control range of an objective marker, friendly *infantry* units which are within 5” of this unit reduce the damage characteristic of incoming ranged attacks by 1.</description>
        </rule>
        <rule name="Skjalos Command - Aura (10”)" id="bd53-abd9-d0ab-8cea" hidden="false">
          <description>Groups including this unit can use its Morale characteristic instead of their own. In addition, visible friendly *infantry* units within 10” of any units with this ability add 1 to their attrition test rolls.</description>
        </rule>
      </rules>
