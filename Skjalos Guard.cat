    <profile name="Heavy Incineration Battery" typeId="f94b-6526-ad27-3051" typeName="Ranged Weapon" hidden="false" id="ce64-3e2a-eadb-5fce">
      <characteristics>
        <characteristic name="Range" typeId="1023-f0db-ffcf-da31">16&quot;</characteristic>
        <characteristic name="Dice" typeId="1192-2222-5926-5b4b">2D5</characteristic>
