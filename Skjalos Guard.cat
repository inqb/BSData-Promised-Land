    </profile>
    <profile name="Ancestral Blades" typeId="profile-invocation" typeName="Invocation" hidden="false" id="2fc0-7f9b-0ba1-3edf">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">12 - Curse</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">This invocation is a *psychic blast* attack, with a 3” radius originating from a visible point within 18” of the invoking unit, however attack rolls are made with an unmodified D5 roll, against the target unit’s Morale instead of its Defence characteristic.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit immediately loses D5 points of health.</characteristic>
      </characteristics>
    </profile>
    <profile name="Clairvoyance" typeId="profile-invocation" typeName="Invocation" hidden="false" id="dd27-19ed-5be0-99c9">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">10 - Blessing</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select a visible enemy *infantry* or *monster* unit (other than *dæmon* units) within 48” of the invoking unit, and one friendly unit within 12” of this unit. The target unit counts as being within range of all friendly ranged weapons (except weapons with the words ‘pistol’, ‘flame’ or ‘incinerator’, or derivatives of those words, in their name).</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit is blinded until the end of the turn. A blind unit:
* Limits all of its aura abilities to 3”
* Cannot be affected by any abilities from friendly units that are more than 3” away
* Counts all targets more than 3” away as not being visible.</characteristic>
      </characteristics>
    </profile>
    <profile name="Frostbite" typeId="profile-invocation" typeName="Invocation" hidden="false" id="48e9-ac86-23dd-1849">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">6 - Curse</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select a visible enemy *infantry* unit within 18” of the invoking unit. Roll a dice for each attrition point allocated to that unit. For each natural roll of a 10, a model in that unit is slain. Attrition points allocated to a unit as a result of this invocation do not allow the invoking player to roll additional dice for resolving this effect.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit immediately gains two attrition points.</characteristic>
      </characteristics>
    </profile>
    <profile name="Snowblind" typeId="profile-invocation" typeName="Invocation" hidden="false" id="7e7b-0ae5-b5e3-fc98">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">7 - Innate, Blessing</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select a visible enemy *infantry* or *monster* unit or group within 18” of the invoking unit.
That unit or group has disadvantage on all of its attacks until the end of the turn.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit has disadvantage on all of its attacks until the end of the turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="War Chant" typeId="profile-invocation" typeName="Invocation" hidden="false" id="9a11-e8d8-527f-905f">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">9 - Innate, Blessing</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select a visible friendly *infantry* unit within 12” of the invoking unit. This unit adds 1 to its melee weapons’ strength and its defence characteristic until the end of the turn.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit immediately gains an attrition point.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dozer Blade" typeId="2857-5ab3-db0f-64a1" typeName="Melee Weapon" hidden="false" id="75ea-8496-fca8-5c96">
      <characteristics>
        <characteristic name="Dice" typeId="e736-f6b3-0474-ddb8">D5</characteristic>
        <characteristic name="Strength" typeId="9a62-cd45-d844-0bc3">+1</characteristic>
        <characteristic name="Damage" typeId="2780-b560-1641-b9a5">3</characteristic>
        <characteristic name="Traits" typeId="1977-0f4d-9e75-2e2d">Units equipped with this weapon can move through terrain features less than 3” tall, and have a strength characteristic of +5 and a damage characteristic of 8 when targeting *structures*.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mine Plough" typeId="2857-5ab3-db0f-64a1" typeName="Melee Weapon" hidden="false" id="7bb3-cea4-796f-927c">
      <characteristics>
        <characteristic name="Dice" typeId="e736-f6b3-0474-ddb8">D5+3</characteristic>
        <characteristic name="Strength" typeId="9a62-cd45-d844-0bc3">+1</characteristic>
        <characteristic name="Damage" typeId="2780-b560-1641-b9a5">2</characteristic>
        <characteristic name="Traits" typeId="1977-0f4d-9e75-2e2d">*Trap* abilities have no effect if they were triggered by a unit equipped with this weapon.</characteristic>
      </characteristics>
    </profile>
