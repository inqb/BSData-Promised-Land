                    <characteristic name="Dice" typeId="1192-2222-5926-5b4b">2D5</characteristic>
                    <characteristic name="Strength" typeId="ff5b-347b-c7f0-5770">+3</characteristic>
                    <characteristic name="Damage" typeId="a482-225f-a3cb-a700">2</characteristic>
                    <characteristic name="Traits" typeId="76cd-5882-86da-52cf">Units do not benefit from cover when being targeted by this weapon. Each time this weapon inflicts a successful hit on an *infantry* or *monster* unit, its target gains one attrition point, and that unit is *burning* until it rallies.
Each time a *burning* unit fails an attrition roll, it loses one point of health.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
