      </characteristics>
    </profile>
    <profile name="Legionary Axe" typeId="2857-5ab3-db0f-64a1" typeName="Melee Weapon" hidden="false" id="780f-8c30-484a-517c">
      <characteristics>
        <characteristic name="Dice" typeId="e736-f6b3-0474-ddb8">3</characteristic>
