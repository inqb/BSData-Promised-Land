        <characteristic name="Damage" typeId="2780-b560-1641-b9a5">1</characteristic>
        <characteristic name="Traits" typeId="1977-0f4d-9e75-2e2d"/>
      </characteristics>
    </profile>
    <profile name="Bladed Shield" typeId="2857-5ab3-db0f-64a1" typeName="Melee Weapon" hidden="false" id="cb00-635b-1aec-ea91">
      <characteristics>
        <characteristic name="Dice" typeId="e736-f6b3-0474-ddb8">2</characteristic>
        <characteristic name="Strength" typeId="9a62-cd45-d844-0bc3">+2</characteristic>
        <characteristic name="Damage" typeId="2780-b560-1641-b9a5">2</characteristic>
        <characteristic name="Traits" typeId="1977-0f4d-9e75-2e2d">Melee attacks that target a unit equipped with Bladed Shields while the attacking model is within its front arc have disadvantage. This has no effect on *destroyer* or *psychic* attacks, or any attacks made by *leviathan* units.</characteristic>
      </characteristics>
    </profile>
    <profile name="Heavy Autocannon Battery" typeId="f94b-6526-ad27-3051" typeName="Ranged Weapon" hidden="false" id="a697-657d-aa90-139a">
      <characteristics>
        <characteristic name="Range" typeId="1023-f0db-ffcf-da31">36&quot;</characteristic>
        <characteristic name="Dice" typeId="1192-2222-5926-5b4b">4</characteristic>
        <characteristic name="Strength" typeId="ff5b-347b-c7f0-5770">+3</characteristic>
        <characteristic name="Damage" typeId="a482-225f-a3cb-a700">4</characteristic>
        <characteristic name="Traits" typeId="76cd-5882-86da-52cf"/>
      </characteristics>
    </profile>
    <profile name="Marauder Cannon Battery" typeId="f94b-6526-ad27-3051" typeName="Ranged Weapon" hidden="false" id="9606-7306-ad3e-6c44">
      <characteristics>
        <characteristic name="Range" typeId="1023-f0db-ffcf-da31">72&quot;</characteristic>
        <characteristic name="Dice" typeId="1192-2222-5926-5b4b">2</characteristic>
        <characteristic name="Strength" typeId="ff5b-347b-c7f0-5770">+4</characteristic>
        <characteristic name="Damage" typeId="a482-225f-a3cb-a700">3</characteristic>
        <characteristic name="Traits" typeId="76cd-5882-86da-52cf">Each time this weapon attacks, it makes a *blast* attack targeting a visible point on the battlefield, with a blast radius of 2&quot;. Each time this weapon attacks, it must select the same point on the battlefield.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Searchlights" id="rule-shared-searchlights" hidden="false">
      <description>When a unit with searchlights makes a Shoot action, if it did not move in the preceding Movement Phase, before making any attacks it can focus its searchlights on one of its targets.
The target unit does not benefit from cover during this attack.</description>
    </rule>
    <rule name="Reinforced Prow" id="rule-shared-reinforced-prow" hidden="false">
      <description>Units with reinforced armour add 2 to their Defence characteristic when targeted by units within its front arc.</description>
    </rule>
    <rule name="Rugged Plate" id="rule-rugged-plate" hidden="false">
      <description>Attacks with a damage characteristic of 2 or less that target this unit are made with disadvantage.</description>
    </rule>
    <rule name="Explosive End (D5&quot;)" id="rule-explosive-end" hidden="false">
      <description>When this unit is destroyed, before removing the model, roll a dice. On a 7+, it explodes in a D5” blast radius from its base, with a strength of +3 and a damage of 1.</description>
    </rule>
    <rule name="Primordial Relic" id="rule-primordial-relic" hidden="false">
      <description>This unit cannot have any points of health restored to it by any means. Friendly *infantry* units within 6” of this unit can reroll natural attrition test rolls of 1.</description>
    </rule>
    <rule name="Siege Shield" id="0162-21d9-a143-8fdc" hidden="false">
      <description>Melee attacks with a strength of +2 or less that target a unit entirely equipped with Siege Shields have disadvantage. This has no effect on *destroyer* or *psychic* attacks, or any attacks made by *leviathan* units.</description>
    </rule>
    <rule name="Lords of a Sundered Kingdom" id="5842-c7bc-b42e-5309" hidden="false">
      <description>Your force may only ever include one *Marshal* unit, and if your force includes one, it is always your *warlord*, superseding all other options.</description>
    </rule>
    <rule name="The Scent of Fear" id="54bf-9cce-b3e3-5404" hidden="false">
      <description>When this unit makes a Fight action, it can reroll a number of attack rolls equal to the number of attrition points already allocated to the target of the attack.</description>
    </rule>
    <rule name="Theroid Wrath" id="372b-ff93-5abd-bec3" hidden="false">
      <description>Immediately after this unit has finished a successful charge move, make D5 attack rolls against their charge target with +1 strength and a damage characteristic of 1.</description>
    </rule>
    <rule name="Visceral Feast" id="52f3-b75f-5b56-2212" hidden="false">
      <description>If this unit destroys an enemy *infantry* unit in the same turn in which it made a charge move, every visible enemy *infantry* unit within 6&quot; of this unit must subtract 1 from their morale characteristic until the end of the turn.</description>
    </rule>
    <rule name="Outlander Adaptation" id="5a40-ba7b-6297-fd46" hidden="false">
      <description>This unit ignores the effects of Difficult terrain and can move through terrain features less than 3” tall.</description>
    </rule>
  </sharedRules>
