      <rules>
        <rule name="Sykaran Commander - Aura (6&quot;)" id="rule-sykaran-comm" hidden="false">
          <description>Friendly *troops* units within 6” of this unit add 1 to their initiative characteristics, and may reroll natural attack rolls of 1 when making an attack as part of a reaction. In addition, groups including this unit can use its Initiative characteristic instead of their own.</description>
        </rule>
        <rule name="Lord of Slaughter" id="rule-lord-slaughter" hidden="false">
          <description>In any turn which this unit or a group including this unit makes a charge move, health points lost in excess of a model’s health characteristic as a result of attacks with this unit or any grouped unit are not discarded, but instead allocated to the next model in the unit.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Wargear" id="6469-fa58-3c1d-c1bd" hidden="false" sortIndex="2">
          <selectionEntryGroups>
            <selectionEntryGroup name="Trait" id="9156-7371-b0be-6cb9" hidden="false">
              <constraints>
                <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d605-92fb-81bb-18d9-min"/>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d605-92fb-81bb-18d9-max"/>
              </constraints>
              <selectionEntries>
                <selectionEntry type="upgrade" import="true" name="Blood Hunter" hidden="false" id="d365-2dbb-601c-79b5">
                  <rules>
                    <rule name="Blood Hunter" id="6963-d290-a3eb-b92d" hidden="false">
                      <description>This unit may reroll one attack roll targeting *infantry* units for each attrition point its target has allocated to it at the beginning of a Fight action.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="The Hand of Blood" hidden="false" id="68ac-3876-dd82-0f9e">
                  <rules>
                    <rule name="The Hand of Blood" id="48f2-195a-ce53-1a69" hidden="false">
                      <description>This unit has advantage when attacking with melee weapons, but misses during Fight actions are not discarded. Instead, such misses are instead allocated as hits to units grouped with this unit, or the nearest friendly unit within 3” of it if it is not part of a group.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Slayer of Nightmares" hidden="false" id="bb51-5d94-a6e5-f765">
                  <rules>
                    <rule name="Slayer of Nightmares" id="79f3-4af3-49ab-bfc2" hidden="false">
                      <description>Each time this unit, or a group including this unit, destroys a *construct* or *monster*, this unit permanently adds 1 to its morale and speed characteristics</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Sykaran Paladin" hidden="false" id="8cfb-ffa0-b827-0978">
                  <rules>
                    <rule name="Sykaran Paladin" id="449a-06ea-eaf4-a46c" hidden="false">
                      <description>When a group including this unit makes a Fight action, or a Fight action targets a group including this unit, it can declare a challenge to an enemy *leader* in a group that is either targeting this unit or being targeted by this unit’s Fight action.
If the challenge is accepted, attacks from both this unit and the challenged *leader* unit can only target each other, and other unit’s melee attacks cannot be allocated to them (overriding all other abilities). If the challenge is refused, the enemy unit immediately gains one attrition point.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Warden of the Empire" hidden="false" id="c84f-0630-f217-e021">
                  <rules>
                    <rule name="Warden of the Empire" id="2a0c-e3c7-8feb-f547" hidden="false">
                      <description>While this unit is within control range of an objective marker, reduce the damage characteristic of incoming attacks by 1.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
