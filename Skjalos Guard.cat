        <categoryLink targetId="5197-d5a9-0a82-eef0" id="bbcd-2500-d1ca-614b" primary="false" name="Wraith"/>
      </categoryLinks>
      <profiles>
        <profile name="Wraith Trooper" typeId="profile-unit" typeName="Unit" hidden="false" id="prof-wraith-trooper">
          <characteristics>
            <characteristic name="Speed" typeId="char-speed">6</characteristic>
            <characteristic name="Health" typeId="char-health">1</characteristic>
            <characteristic name="Defence" typeId="char-defence">6</characteristic>
            <characteristic name="Initiative" typeId="char-initiative">3</characteristic>
            <characteristic name="Morale" typeId="char-morale">2</characteristic>
            <characteristic name="Arcane" typeId="char-arcane">-</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Disposable Regiments" id="rule-disposable-regiments" hidden="false">
          <description>This unit can never contest or claim objective markers and victory points cannot be scored for any objectives by destroying this unit.</description>
        </rule>
        <rule name="Redemption in Death" id="rule-redemption-in-death" hidden="false">
          <description>Once per battle, when this unit finishes a normal move or charge move, if this unit is equipped with Caskets of Redemption, it can detonate them. For each unit within 6” of this unit (including itself) make a number of attack rolls equal number of models in this unit, with a strength of +3 and a damage characteristic of 2.
A unit with caskets of redemption can accidentally detonate when they lose points of health to any weapons or abilities including the word ‘fire’, ‘inferno’, ‘explosion’, ‘blaze’ or ‘incinerate’ in their names (or any derivations of those words), or the detonation of another unit’s Caskets of Redemption. Each time it does so, roll a dice. If any result is a 6+, its Caskets of Redemption immediately detonate.</description>
        </rule>
      </rules>
