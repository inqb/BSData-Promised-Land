      <rules>
        <rule name="Eyes of the Overlord" id="a9d0-e6aa-6a1d-e7c8" hidden="false">
          <description>During deployment, models in this unit do not have to be placed within control range of each other and can be grouped with different units. As soon as this unit is deployed, each model is treated as a separate unit until the end of the battle.
Models in this unit cannot contest or claim any objective markers and do not accrue attrition points, and no abilities are triggered, nor victory points scored, when they are destroyed.</description>
        </rule>
        <rule name="Thralls to a Greater Mind" id="c191-02fe-7d71-8197" hidden="false">
          <description>Friendly *hieronite* units grouped with a unit with this rule ignore the effects of being *shaken*.</description>
        </rule>
      </rules>
