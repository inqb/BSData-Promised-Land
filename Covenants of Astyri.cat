    <selectionEntry type="model" import="true" name="Iconoclast" hidden="false" id="d321-f4db-6b38-eea9">
      <costs>
        <cost name="Auri" typeId="cost-auri" value="90"/>
      </costs>
      <profiles>
        <profile name="Iconoclast" typeId="profile-unit" typeName="Unit" hidden="false" id="a02c-5903-783c-1baf">
          <characteristics>
            <characteristic name="Speed" typeId="char-speed">10</characteristic>
            <characteristic name="Health" typeId="char-health">8</characteristic>
            <characteristic name="Defence" typeId="char-defence">8</characteristic>
            <characteristic name="Initiative" typeId="char-initiative">5</characteristic>
            <characteristic name="Morale" typeId="char-morale">4</characteristic>
            <characteristic name="Arcane" typeId="char-arcane">-</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Covenant Retinue" id="5791-c474-5535-8e0c" hidden="false">
          <description>One *hieronite* *troops* unit recruited in this unit’s warband can be a covenant retinue. If a warband includes a covenant retinue, the unit with this rule must join it during deployment, and the covenant retinue gains the *vanguard* keyword.</description>
        </rule>
        <rule name="Thralls to a Greater Mind - Aura (10&quot;)" id="96fb-b01b-581d-27a8" hidden="false">
          <description>Friendly visible *hieronite* units do not count as *shaken* while within 10” of this unit.</description>
        </rule>
        <rule name="By My Hand, This Mortal World Shall Burn - Command action" id="6923-74c7-87bc-06fb" hidden="false">
          <description>Select one visible enemy unit to be the target of annihilation. Until the end of that turn, friendly *hieronites* add 1 to their attack rolls with melee weapons against the target of annihilation. Only one friendly unit can make this action each turn.</description>
        </rule>
      </rules>
