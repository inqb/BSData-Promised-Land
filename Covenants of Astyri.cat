  <sharedProfiles>
    <profile name="Unearting" typeId="profile-invocation" typeName="Invocation" hidden="false" id="9aa2-2aeb-a06d-7cf0">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">8 - Elemental</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select a visible point within 20” of the invoking unit and roll a dice for each unit within 5” of that point. On a 4+, that unit must half its Speed characteristic (rounding up) until the end of the turn.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">Roll a dice for each unit within 2” of the invoking unit. On a 6+, that unit must half its Speed characteristic (rounding up) until the end of the turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Will of Iron" typeId="profile-invocation" typeName="Invocation" hidden="false" id="1eb4-1f68-242d-4be3">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">9 - Blessing</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select a visible enemy *vehicle* or *construct* (excluding *leviathans*) within 24” of the invoking unit and roll a D5. If the roll matches or exceeds the target unit’s Morale characteristic, it immediately makes a Shoot or Fight action targeting a unit of the invoking player’s choice.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit cannot make Fight or Shoot actions during the Combat Phase of this turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Dominate" typeId="profile-invocation" typeName="Invocation" hidden="false" id="9852-d255-0121-a096">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">5 - Curse</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select a visible enemy *infantry* unit within 20” of the invoking unit.
Both players roll-off, adding 1 to the invoking player’s roll if the invoking unit’s Morale characteristic is double that of the target unit. If the invoking player’s result is equal to or greater than the targeted player’s roll, the target unit immediately gains two attrition points.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit immediately gains two attrition points.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rampage" typeId="profile-invocation" typeName="Invocation" hidden="false" id="22a7-1eb0-5f82-5157">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">6 - Blessing</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select a visible friendly infantry unit within 10” of the invoking unit. This unit can then immediately make a Fight action as if it were the combat phase.
Once this unit has finished making its attacks, roll a dice for each model in the unit. For each roll of a 10, a model in that unit is slain.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">Roll a dice for each model in the target unit. For each roll of an 8+, a model in that unit is slain.</characteristic>
      </characteristics>
    </profile>
    <profile name="Deflagration" typeId="profile-invocation" typeName="Invocation" hidden="false" id="0b06-24db-925b-4628">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">6 - Elemental</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select a visible point within 15” of the invoking unit as the origin point of a *psychic blast* attack, with a radius of 2”. This attack has a strength of +3 and a damage of 2.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">Resolve a *psychic blast* attack with a radius of 2”, originating from the invoking unit.
This attack has a strength of +3 and a damage of 2.</characteristic>
      </characteristics>
    </profile>
