  <sharedSelectionEntries>
    <selectionEntry type="upgrade" import="true" name="The Covenant Legions" hidden="false" id="ead4-f076-8290-9700">
      <selectionEntryGroups>
        <selectionEntryGroup name="The Covenant Legions (Choose 2)" id="fbdd-8c5f-a9f0-794d" hidden="false">
          <constraints>
            <constraint type="max" value="2" field="selections" scope="parent" shared="true" id="c17c-0646-0535-9685" includeChildSelections="false"/>
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Ironflesh Horrors" hidden="false" id="472b-bccb-7564-90d3">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4997-9cde-87db-2c14" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Ironflesh Horrors" id="4552-6fce-62c2-4003" hidden="false">
                  <description>Enemy units within the control range of any friendly *infantry* units must subtract 1 from their attrition test rolls.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Exalted Ochystanites" hidden="false" id="89ef-eabc-47e9-31e6">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7d6d-5c65-442d-c947" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Exalted Ochystanites" id="a4a9-fb3e-e645-30fc" hidden="false">
                  <description>Each time an enemy unit attempts an invocation that targets a friendly unit or is a *psychic* attack, they must subtract 1 from their invocation roll.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Radium Cores" hidden="false" id="eeb9-19c0-d0b1-44ac">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="20b5-3023-8414-edf6" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Radium Cores" id="4cad-37e3-8319-320d" hidden="false">
                  <description>Enemy *infantry* units within 3” of any friendly *infantry* units must subtract 1 from their armour characteristic, but each time a friendly infantry unit fails an attrition test, they lose a point of health.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Annihilators" hidden="false" id="c471-7913-24af-35fd">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="dfa3-e62e-027e-0bcc" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Annihilators" id="eb60-43f5-2386-058b" hidden="false">
                  <description>Friendly units can reroll natural attack rolls of 1 when targeting a unit that have lost any models or health this turn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hieronite Onslaught" hidden="false" id="f4f8-5f39-5b32-3fc4">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8ae3-7a3f-59a0-6eb5" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Hieronite Onslaught" id="f0c9-984e-7135-9e3a" hidden="false">
                  <description>Each time a friendly unit makes a charge move, roll one additional dice to determine its charge distance.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Vanguard Covenant" hidden="false" id="b351-7662-19fa-89c4">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4375-41c0-aae3-5a12" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Vanguard Covenant" id="699b-726b-7dbc-e443" hidden="false">
                  <description>After deployment, up to five friendly *infantry* or *vanguard* units can immediately make a normal move, but those units cannot be activated in the combat phase of the first turn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Vengeance Upon the Living" hidden="false" id="1197-54b2-075b-228c">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c249-d361-1068-218d" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Vengeance Upon the Living" id="c101-e3c6-d934-113b" hidden="false">
                  <description>Friendly *construct* units have advantage with their melee weapons when targeting *infantry* units.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Conquest Above All" hidden="false" id="2a23-a5a4-ba12-f336">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="439b-d8ff-1579-98db" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Conquest Above All" id="1e19-dc7e-d38f-0ae5" hidden="false">
                  <description>Friendly *infantry* units add 1 to their defence characteristics against weapons with a damage characteristic of 1 while they are wholly outside their deployment zone.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="The Shroud of Industry" hidden="false" id="cf1d-216f-5902-584c">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7e0a-cdd3-61ef-28e7" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="The Shroud of Industry" id="37ee-94e8-9508-ef94" hidden="false">
                  <description>Add 2 to rolls made to negate hits against *infantry* units when using the Vedette Shields rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Engine Hunters" hidden="false" id="4383-1d90-216a-8644">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a8bb-60ba-e13a-d281" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Engine Hunters" id="df3a-f33c-9754-686e" hidden="false">
                  <description>Friendly units can reroll natural attack rolls of 1 when targeting *construct* units.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
