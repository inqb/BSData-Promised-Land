      </costs>
      <rules>
        <rule name="Lords of the Slave Legions" id="df18-cf16-2048-ce88" hidden="false">
          <description>Your force may only ever include one *Overlord* unit, and if your force includes one, it is always your *warlord*, superseding all other options.</description>
        </rule>
        <rule name="Thralls to a Greater Mind - Aura (10”)" id="effb-843f-9d23-78dd" hidden="false">
          <description>Friendly visible *hieronite* units do not count as *shaken* while within 10” of this unit.</description>
        </rule>
      </rules>
