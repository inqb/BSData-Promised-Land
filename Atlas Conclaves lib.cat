        <characteristic name="Traits" typeId="76cd-5882-86da-52cf">This is a *blast* attack, with a 3” radius originating from a visible point within range.</characteristic>
      </characteristics>
      <attributes>
        <attribute name="Traits" typeId="5152-ff25-1d12-ec4c">After selecting a target within range, draw a line between this model and one model in the target unit. Make a number of attack rolls against each unit this line crosses, equal to the number of models the line crosses over.</attribute>
      </attributes>
    </profile>
