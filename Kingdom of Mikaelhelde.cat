  <sharedRules>
    <rule name="Fleshwrought Abominations (8+)" id="1c40-0281-0ec5-b2cb" hidden="false">
      <description>Each time a model from this unit is slain, roll a dice. On a roll of an 8+, that model remains alive with a single point of health remaining. This has no effect on *destroyer* attacks.</description>
    </rule>
    <rule name="Fleshwrought Abominations (10+)" id="50b6-7cf2-2776-06ae" hidden="false">
      <description>Each time a model from this unit is slain, roll a dice. On a roll of an 10+, that model remains alive with a single point of health remaining. This has no effect on *destroyer* attacks.</description>
    </rule>
    <rule name="A Construct of Ancient Stone" id="3dac-2ffa-ebe9-3d88" hidden="false">
      <description>All attacks except *destroyer* attacks have disadvantage against this unit. In addition, this unit never accumulates attrition points and is immune to any attacks and effects based on morale or initiative.
This unit never counts as being obscured by intervening units, and cannot make reactions, or contest or claim objective markers.</description>
    </rule>
    <rule name="A Relic of the Primordial World" id="28ee-2333-5eec-2b99" hidden="false">
      <description>The following rules apply to this unit:
* All attacks (except *destroyer* attacks) have disadvantage against this unit.
* This unit never accumulates attrition points.
* This unit never benefits from cover
* This unit cannot or contest or claim objective markers.
* Friendly *mystic* units within 6” of this unit add 1 to their Arcane characteristic.
* Enemy units within 6” of this unit reduce their Morale characteristic by 1.
* If all friendly *leader* units are slain, this unit is immediately destroyed.</description>
    </rule>
    <rule name="Soul Eater" id="590e-dc58-646b-83ad" hidden="false">
      <description>If this unit destroys an enemy unit, all friendly units within 12” can reroll natural invocation rolls of 1 until the end of the battle.</description>
    </rule>
    <rule name="Rupture of Reality" id="43df-968f-d742-3136" hidden="false">
      <description>When this unit is destroyed, it is replaced by a marker of an equivalent base size. At the end of each combat phase, make an attack roll for each unit, equal to the number of models within 3” of the marker, with a strength of +5 and a damage of 1.</description>
    </rule>
    <rule name="Explosive End (D5”)" id="a56d-7894-0e66-e162" hidden="false">
      <description>When this unit is destroyed, before removing the model, roll a dice. On a 5+, it explodes in a blast attack, with a D5” radius originating from its base, with a strength of +3 and a damage of 1. If, during this turn, this unit moved 10” or more, this unit automatically explodes without rolling.</description>
    </rule>
  </sharedRules>
  <sharedProfiles>
    <profile name="Butcher&apos;s Blade" typeId="2857-5ab3-db0f-64a1" typeName="Melee Weapon" hidden="false" id="134e-5b2c-cddd-d337">
      <characteristics>
        <characteristic name="Dice" typeId="e736-f6b3-0474-ddb8">2</characteristic>
        <characteristic name="Strength" typeId="9a62-cd45-d844-0bc3">+2</characteristic>
        <characteristic name="Damage" typeId="2780-b560-1641-b9a5">1</characteristic>
        <characteristic name="Traits" typeId="1977-0f4d-9e75-2e2d"/>
      </characteristics>
    </profile>
    <profile name="Turgescence" typeId="profile-invocation" typeName="Invocation" hidden="false" id="7e6a-2312-80f6-2291">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">12 - Curse</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select a visible enemy *infantry* unit with a Health characteristic of 3 or less, within 18” of the invoking unit and roll a D5. If this roll exceeds the Initiative of that unit (and is not a roll of a 1), a model within range is slain, and you may roll again. Repeat this until either a model fails to be slain, or a total of five models have been slain from the unit.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit immediately loses D5 points of health.</characteristic>
      </characteristics>
    </profile>
    <profile name="Warding" typeId="profile-invocation" typeName="Invocation" hidden="false" id="e608-0af7-2628-19ae">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">7 - Blessing, Aura (6&quot;)</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Until the beginning of the next combat phase, friendly units within 6” of the invoking unit can reroll any failed Fleshwrought Abominations ability rolls.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit loses the Fleshwrought Abominations ability until the end of this turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Planeshift" typeId="profile-invocation" typeName="Invocation" hidden="false" id="030c-954b-7472-b322">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">10 - Elemental</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select an *infantry* unit within 6” of the invoking unit, and a point within 18”. Each model in target unit is immediately moved as close to the selected point as possible, in an order of the invoking player’s choice. This unit must end its move outside of any enemy units’ control range and outside of any impassable terrain.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit gains two attrition points.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Becoming" typeId="profile-invocation" typeName="Invocation" hidden="false" id="fd6e-e592-cc1b-9f95">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">6 - Blessing</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Until the end of the turn, the invoking unit is a *Dæmon*, with the following modifiers applied until the end of the turn:
* Add 1 to all of this unit’s melee weapons’ Dice characteristics.
* This unit adds 2 to its Defence, Speed and Initiative characteristics.
* This unit can choose to immediately make a Fight action, but if it does so, it cannot make any actions in the Combat Phase. At the end of the Combat Phase, the invoking unit gains four attrition points.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit gains four attrition points.</characteristic>
      </characteristics>
    </profile>
    <profile name="Infernal Darkness" typeId="profile-invocation" typeName="Invocation" hidden="false" id="4509-c193-a706-0814">
      <characteristics>
        <characteristic name="Arcane Value" typeId="char-arc-val">8 - Curse</characteristic>
        <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select an enemy *infantry* unit or group within 24” of the invoking unit. The target unit is enveloped by darkness until the end of the turn.
A unit enveloped by darkness:
* Limits all of its aura abilities to 3”
* Cannot be affected by any abilities from friendly units that are more than 3” away
* Counts all targets more than 3” away as not being visible.</characteristic>
        <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit is enveloped by darkness instead.</characteristic>
      </characteristics>
    </profile>
