            <characteristic name="Morale" typeId="char-morale">10</characteristic>
            <characteristic name="Arcane" typeId="char-arcane">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Void Reverberance" typeId="2857-5ab3-db0f-64a1" typeName="Melee Weapon" hidden="false" id="b6db-f81e-b332-96ff">
          <characteristics>
            <characteristic name="Dice" typeId="e736-f6b3-0474-ddb8">2D10</characteristic>
            <characteristic name="Strength" typeId="9a62-cd45-d844-0bc3"/>
            <characteristic name="Damage" typeId="2780-b560-1641-b9a5">3</characteristic>
            <characteristic name="Traits" typeId="1977-0f4d-9e75-2e2d"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="A Birth of Aberrant Flesh - Command action, Resurrection" id="5b71-97ac-c850-70c6" hidden="false">
          <description>Each time a friendly unit of Fleshlings is destroyed within 12” of this unit, roll a dice. On an 8+, during the following Strategy Phase, it can make this action.
That unit is no longer destroyed, and can be placed wholly within 6” of a unit with this rule, and more than 1” away from all enemy units, with all of its slain models returned at full health.
Only one friendly unit may make this action each turn.</description>
        </rule>
        <rule name="Incarnation of Sorcery" id="9aed-4923-0532-d194" hidden="false">
          <description>While this unit is on the battlefield, all friendly *mystic* units add 1 to their Arcane characteristic. This is effect is not cumulative with multiple Arcane Oblivions.
In addition, this unit may make one invocation per turn as if it were a *mystic*. This invocation automatically succeeds and counterspells cannot be used against it.</description>
        </rule>
        <rule name="The Rites of Oblivion - Command action" id="79bf-3467-cbef-023e" hidden="false">
          <description>During the Strategy Phase, one unit with this ability can make this action. Each unit with this ability can perform it once per battle.
If there are twelve or more friendly units’ *void echo* and *resonance* units on the battlefield, each enemy unit (excluding *independent* units) within 20” of this unit loses D10 points of health.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="A Construct of Ancient Stone" id="355a-dc56-3cd5-16d2" hidden="false" type="rule" targetId="3dac-2ffa-ebe9-3d88"/>
