      <rules>
        <rule name="Rippers" id="139b-db13-4a31-d6db" hidden="false">
          <description>Each time this unit makes a successful charge, it and any unit it is grouped with may reroll attack rolls of 1 made with melee weapons until the end of the turn.</description>
        </rule>
      </rules>
