      </costs>
      <rules>
        <rule name="Visage of Abyssal Dread - Aura (10&quot;)" id="e25b-f068-f4cb-09db" hidden="false">
          <description>Natural attacks rolls of 1-4 made by enemy units within 10&quot; of this unit always fail, regardless of any modifiers.
Each time an enemy unit within 10&quot; makes a failed attrition test roll, it loses one point of health. In addition, each time an enemy unit within 10&quot; of this unit makes a failed attrition test roll, this unit&apos;s controlling player may remove an attrition point from a friendly unit within 10&quot; of this unit.</description>
        </rule>
      </rules>
      <profiles>
        <profile name="Cardinal" typeId="profile-unit" typeName="Unit" hidden="false" id="2c58-bce2-1bff-72c5">
          <characteristics>
            <characteristic name="Speed" typeId="char-speed">8</characteristic>
            <characteristic name="Health" typeId="char-health">10</characteristic>
            <characteristic name="Defence" typeId="char-defence">8</characteristic>
