        <profile name="Sorcerous Blades" typeId="profile-invocation" typeName="Invocation" hidden="false" id="84b6-c6f8-031f-f86f">
          <characteristics>
            <characteristic name="Arcane Value" typeId="char-arc-val">12 - Innate, Curse</characteristic>
            <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select a visible enemy *infantry* or *monster* unit within 18” of the invoking unit and roll 2D5.
The target unit loses a number of points of health equal to the result, subtracting the target’s Defence characteristic.</characteristic>
            <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">The invoking unit immediately gains an attrition point.</characteristic>
          </characteristics>
        </profile>
