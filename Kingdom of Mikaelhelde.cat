            <characteristic name="Morale" typeId="char-morale">3</characteristic>
            <characteristic name="Arcane" typeId="char-arcane">4</characteristic>
          </characteristics>
        </profile>
        <profile name="The Gift of Life" typeId="profile-invocation" typeName="Invocation" hidden="false" id="1da9-13bc-f64e-86fa">
          <characteristics>
            <characteristic name="Arcane Value" typeId="char-arc-val">8 - Blessing, Aura (12&quot;)</characteristic>
            <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Until the following mystic phase, friendly visible units within 12” of this unit add 1 to Fleshwrought Abomination rolls.</characteristic>
            <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">If this invocation misfires, the invoking unit immediately gains four attrition points.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Path to Ascension" typeId="profile-invocation" typeName="Invocation" hidden="false" id="2ac6-9e49-6b94-7784">
          <characteristics>
            <characteristic name="Arcane Value" typeId="char-arc-val">10 - Blessing</characteristic>
            <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Until the following mystic phase, all friendly units on the battlefield can reroll one of their charge roll dice.</characteristic>
            <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">If this invocation misfires, all friendly units within 12” of this unit reduce their Speed by 2 until the end of the Movement Phase.</characteristic>
          </characteristics>
        </profile>
        <profile name="Divine Intervention" typeId="profile-invocation" typeName="Invocation" hidden="false" id="69c0-6393-3b9f-6e91">
          <characteristics>
            <characteristic name="Arcane Value" typeId="char-arc-val">12 - Resurrection</characteristic>
            <characteristic name="Effects" typeId="2062-1aef-9b73-d14b">Select one unit that was slain in this or any previous turn. An identical unit is placed within 12” of this unit, more than 1” away from any enemy units, with D5 points of health remaining (up to the maximum starting health of that unit). If this unit is *independent* and placed within control range of a friendly *troops* unit, it can immediately join them.
This power may be successfully invoked only once per battle, and after invoking it, roll a dice. On a 1, the invoking unit is slain.</characteristic>
            <characteristic name="Misfire effects" typeId="456c-32eb-69b1-1fb7">If this invocation misfires, the invoking unit is immediately slain.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ritual Blade" typeId="2857-5ab3-db0f-64a1" typeName="Melee Weapon" hidden="false" id="09d8-481a-2f88-3f74">
          <characteristics>
