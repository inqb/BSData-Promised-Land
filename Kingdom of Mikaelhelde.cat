            <characteristic name="Damage" typeId="a482-225f-a3cb-a700">2</characteristic>
            <characteristic name="Traits" typeId="76cd-5882-86da-52cf">This is an *artillery* *blast* attack, with a 2” radius originating from a point within range.</characteristic>
          </characteristics>
