    <selectionEntry type="upgrade" import="true" name="The Emissaries of Wrath" hidden="false" id="85c8-f99d-e1fc-3ab3">
      <categoryLinks>
        <categoryLink targetId="5552-8704-2fc8-e65d" id="53c8-2e53-c9f0-274d" primary="true" name="Force Traits"/>
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="The Emissaries of Wrath (Choose 2)" id="c3d6-849e-0d75-8a7e" hidden="false">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Reavers" hidden="false" id="9164-60a6-d4da-3bf4">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="50ae-0647-744a-18b7" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Reavers" id="2afe-3c06-4ade-5b60" hidden="false">
                  <description>When a friendly non-*incarnate* unit makes a charge move action, it can select one enemy unit within range that it is not within the front arc of as its prey. That unit is then its only eligible charge target, but it can reroll its charge distance.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="No Escape" hidden="false" id="1999-f6b9-b106-f3ba">
              <rules>
                <rule name="No Escape" id="9536-2f4d-9177-83f3" hidden="false">
                  <description>When an enemy unit withdraws from a friendly Acolytes unit, if it is eligible to make a reaction, that Acolyte unit can instead gun them down. If it does so, it makes a Cut Them Down reaction, but does so with its ranged weapons instead of its melee weapons. These attacks ignore the penalties for close-quarters shooting.</description>
                </rule>
              </rules>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1b80-307a-436d-4199" includeChildSelections="false"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Death Magic" hidden="false" id="8b02-6af2-f49c-2ce1">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6880-3a6b-b122-29cb" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Death Magic" id="271f-4a15-bf5c-e1a8" hidden="false">
                  <description>Once per battle, when a friendly *mystic* is channelling their power through another unit, it can imbue that invocation with their souls. That *mystic*’s invocation roll is equivalent to the number of models in that unit.
The channeling unit is then immediately destroyed.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Mystic Munitions" hidden="false" id="aa9d-0b75-95b0-5aa9">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5744-82eb-f837-3136" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Mystic Munitions" id="4d67-79e9-07e6-8e16" hidden="false">
                  <description>If, during the Strategy Phase, an Acolytes unit makes no invocations, until the end of the turn units targeted by that Acolyte unit do not benefit from cover.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="All-Consuming" hidden="false" id="cfa6-1233-0fb6-a412">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="494b-852b-0844-eb0a" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="All-Consuming" id="12cf-6d48-78fd-0d76" hidden="false">
                  <description>Friendly non-*incarnate* units can make charge move actions while within the control range of enemy units, but models in that unit that begin their move within the control range of any enemy units cannot voluntarily end any move outside the control range of any enemy models.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="The Power of Flesh" hidden="false" id="89c2-e8c4-256a-cf19">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9ffe-1773-ad39-694e" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="The Power of Flesh" id="6ffb-3982-45b8-13e7" hidden="false">
                  <description>Friendly non-*incarnate* units have advantage with their melee weapons when targeting *construct* and *vehicle* units.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Brutal Blades" hidden="false" id="6a79-634d-82f2-c948">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="13f0-063d-4295-b495" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Brutal Blades" id="24e5-9833-7efe-da74" hidden="false">
                  <description>If a critical hit is inflicted by a melee weapon against a model, that model must subtract 1 from its attack rolls until the end of the turn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Psychic Dominion" hidden="false" id="7585-13d1-4e0d-d19f">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8204-8b76-23aa-390a" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Psychic Dominion" id="60c7-472d-caac-dd1e" hidden="false">
                  <description>Units making a counterspell reaction add 1 to their Arcane characteristic for each other friendly *mystic* unit within 6” of them (to a maximum bonus of +3).</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Consecration of Blood" hidden="false" id="756e-1244-e1d7-fd70">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4618-c513-e698-ae8d" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Consecration of Blood" id="9190-d39b-7941-ab8f" hidden="false">
                  <description>If a friendly unit destroys an enemy unit while that enemy unit is the only enemy unit within control range of an objective marker, it controls that objective marker until any enemy units end a move within control range of it.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
          <constraints>
            <constraint type="max" value="2" field="selections" scope="parent" shared="true" id="a3fe-da49-1377-de1a" includeChildSelections="false"/>
          </constraints>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <constraints>
        <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="16f9-ffdd-150f-fc88-min" includeChildSelections="false"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="16f9-ffdd-150f-fc88-max" includeChildSelections="false"/>
      </constraints>
    </selectionEntry>
