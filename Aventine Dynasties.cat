        <selectionEntryGroup name="Trait" id="5f31-61d9-f3f2-5319" hidden="false">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="6d3f-e323-f233-7aa1-min"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6d3f-e323-f233-7aa1-max"/>
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Beacon of Heroism" hidden="false" id="3057-5e00-70a6-f5a7">
              <rules>
                <rule name="Beacon of Heroism - Aura" id="92fb-ea57-5f1b-7c68" hidden="false">
                  <description>Friendly units within 6” of this unit add 1 to their attrition test rolls.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Disciple of Hokorek" hidden="false" id="b958-74c6-ecaa-d86b">
              <rules>
                <rule name="Disciple of Hokorek" id="3990-9c11-ca43-9d62" hidden="false">
                  <description>This unit has an Arcane characteristic of 4.</description>
                </rule>
              </rules>
              <modifiers>
                <modifier type="set" value="4" field="char-arcane" affects="profiles.Unit" scope="parent"/>
              </modifiers>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dynastic Champion" hidden="false" id="c4bc-9c49-c937-2b20">
              <rules>
                <rule name="Dynastic Champion" id="d810-0c51-a098-451a" hidden="false">
                  <description>Add 1 to this unit’s attack rolls when it makes attacks with melee weapons.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Indomitable Warrior" hidden="false" id="2c35-dd14-f592-2261">
              <rules>
                <rule name="Indomitable Warrior" id="2ed8-189b-14cb-9cac" hidden="false">
                  <description>This unit may reroll any rolls made as a result of The Divine Right ability.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Nomad Lord" hidden="false" id="2027-827a-e056-31ab">
              <rules>
                <rule name="Nomad Lord – Command action" id="93ba-6e74-d048-47ec" hidden="false">
                  <description>During the Strategy Phase, one unit with this ability can make this action.
During the Strategy Phase, select one unit within an enemy unit’s control range. Until the end of this turn, it can move an additional 2”, and Cut Them Down reactions may not be made against this unit.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
