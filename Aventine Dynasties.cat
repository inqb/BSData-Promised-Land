  <sharedSelectionEntries>
    <selectionEntry type="upgrade" import="true" name="The Aventine Armada" hidden="false" id="241c-e764-e169-65fb">
      <categoryLinks>
        <categoryLink targetId="5552-8704-2fc8-e65d" id="9d79-a38f-cd6b-9e31" primary="true" name="Force Traits"/>
      </categoryLinks>
      <constraints>
        <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="aef9-681f-8fff-3604-min" includeChildSelections="false"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="aef9-681f-8fff-3604-max" includeChildSelections="false"/>
      </constraints>
      <selectionEntryGroups>
        <selectionEntryGroup name="The Aventine Armada (Choose 2)" id="ba3c-8cd8-0b10-6105" hidden="false">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Veteran Pilots" hidden="false" id="9b17-bd28-b319-420c">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1153-52de-3fb0-3d7d" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Veteran Pilots" id="07eb-3323-122f-ed5b" hidden="false">
                  <description>Friendly *airborne* *vehicles* add 2 to their speed characteristics, and add 1 to their initiative characteristics.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Abyssal Craft" hidden="false" id="a74c-7239-1741-db32">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="8ef5-2e70-2064-8f80" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Abyssal Craft" id="149b-d82c-2dae-d440" hidden="false">
                  <description>Friendly *vehicle* units add 1 to their defence characteristics against melee weapons, and all ‘harpoon’ weapons double their damage characteristic.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Aerial Sentinels" hidden="false" id="e7a0-59c0-bb3a-d5ea">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6a44-60d7-bf0f-4ea5" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Aerial Sentinels" id="35b8-05e7-10bf-5fa0" hidden="false">
                  <description>Friendly non-*altitude* *vehicle* units are *core*.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="An Ancient Vengeance" hidden="false" id="7afb-6863-5cc2-23b7">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0edd-112e-3f6f-227b" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="An Ancient Vengeance" id="8506-8f68-b3e5-8f00" hidden="false">
                  <description>Friendly units can add 1 to their attack rolls when targeting *mystic* units, and any enemy *curses* which target friendly units increase their Arcane Value by 1.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Blistering Onslaught" hidden="false" id="0c7f-66e1-85bc-8ec2">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6556-1641-b016-19c4" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Blistering Onslaught" id="10a9-dc0d-6b5d-baae" hidden="false">
                  <description>While targeting a unit within 10”, friendly units’ natural attack rolls of 10 are always considered successful hits, regardless of the target’s defence characteristic.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dynastic Defenders" hidden="false" id="d067-c824-99fb-fc43">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="84d4-7fa7-68d9-df6d" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Dynastic Defenders" id="6691-c4ee-e612-2afc" hidden="false">
                  <description>Add 1 to the attack rolls of friendly *infantry* units until the end of any turn in which they are successfully charged by an enemy unit.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Scout Forces" hidden="false" id="ad3a-0083-55dc-36bc">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d815-280c-47b1-fac8" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Scout Forces" id="ab95-d7b1-f4a9-596e" hidden="false">
                  <description>During the first turn, if any unit makes an advance move, it can move up to its full Speed characteristic instead of only half.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="The Hallowed of Hokorek" hidden="false" id="e23b-5442-f140-efed">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a2d4-bf6d-d076-b16b" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="The Hallowed of Hokorek" id="c16a-b992-9955-f610" hidden="false">
                  <description>Each time a friendly *infantry* model is slain by an acting unit’s attacks, roll a dice. On a natural roll of a 10+, that acting unit loses a point of health. If the model was slain as part of a ranged attack, this rule may only take effect if the slain model had a ranged weapon within contact range of and able to see the attacking unit.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="The Promised Land" hidden="false" id="4287-1d25-d742-cf77">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0d5a-dad6-cd9e-b92d" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="The Promised Land" id="3fc2-875c-7203-7b3b" hidden="false">
                  <description>While within 3” of an objective marker, friendly *infantry* units can reroll natural attrition rolls of 1.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Trench Warriors" hidden="false" id="36ea-a806-3e64-17bd">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3aa0-6eed-1c2e-7b42" includeChildSelections="false"/>
              </constraints>
              <rules>
                <rule name="Trench Warriors" id="9bd2-ed52-2b6f-e801" hidden="false">
                  <description>When a friendly *infantry* unit benefits from cover, they add 3 to their defence characteristic instead of 2.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
          <constraints>
            <constraint type="max" value="2" field="selections" scope="parent" shared="true" id="f8db-6449-2b96-1ac7" includeChildSelections="false"/>
          </constraints>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry type="model" name="Fleetmaster" hidden="false" id="0ae9-f83f-7fc2-dda3">
      <profiles>
        <profile name="Fleetmaster" typeId="profile-unit" typeName="Unit" hidden="false" id="9e40-2f40-dc6f-b296" noindex="false">
          <characteristics>
            <characteristic name="Speed" typeId="char-speed">6</characteristic>
            <characteristic name="Health" typeId="char-health">6</characteristic>
            <characteristic name="Defence" typeId="char-defence">7</characteristic>
            <characteristic name="Initiative" typeId="char-initiative">4</characteristic>
            <characteristic name="Morale" typeId="char-morale">4</characteristic>
            <characteristic name="Arcane" typeId="char-arcane">-</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="The Divine Right" id="5a0c-168b-9211-4e3a" hidden="false">
          <description>Each time this unit is hit by an attack, before inflicting damage, roll a dice. On a natural 8+, that hit is negated.</description>
        </rule>
        <rule name="Lord of Conquest – Command action" id="728b-da2a-bb79-3ca1" hidden="false">
          <description>During the Strategy Phase, one unit with this ability can make this action.
Select one objective marker within 12” of this unit. If, during the subsequent Resolution Phase of that turn, any friendly units (except airborne and shaken units) are within control range of that objective marker, it is claimed by that friendly unit, regardless of any other enemy units in range of it.
Only one friendly unit may make this action each turn.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Auri" typeId="cost-auri" value="90"/>
      </costs>
