    <selectionEntry type="unit" import="true" name="Navigator Engineers" hidden="false" id="f318-05ec-afb4-12b5">
      <profiles>
        <profile name="Navigator Engineers" typeId="profile-unit" typeName="Unit" hidden="false" id="df78-09ae-e3aa-c9e0">
          <characteristics>
            <characteristic name="Speed" typeId="char-speed">6</characteristic>
