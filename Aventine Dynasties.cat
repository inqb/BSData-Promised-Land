                        <characteristic name="Dice" typeId="1192-2222-5926-5b4b">D5</characteristic>
                        <characteristic name="Strength" typeId="ff5b-347b-c7f0-5770">+3</characteristic>
                        <characteristic name="Damage" typeId="a482-225f-a3cb-a700">1</characteristic>
                        <characteristic name="Traits" typeId="76cd-5882-86da-52cf">Units do not benefit from cover when being targeted by this weapon. Each time a unit gains an attrition point as part of an attack that includes this weapon, it gains one additional attrition point. This is not cumulative with other instances of this rule.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
