    <selectionEntry type="model" import="true" name="Grey Shepherd" hidden="false" id="bda9-e6fb-bf41-f3ab">
      <profiles>
        <profile name="Grey Shepherd" typeId="profile-unit" typeName="Unit" hidden="false" id="90bb-6630-7f12-998e">
          <characteristics>
            <characteristic name="Speed" typeId="char-speed">6</characteristic>
            <characteristic name="Health" typeId="char-health">5</characteristic>
