            <characteristic name="Arcane" typeId="char-arcane">-</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Combat Engineers" id="42bd-e8a0-6f4d-9061" hidden="false">
          <description>When this unit activates in the Combat Phase, instead of making any other action, if this unit is more than 6” from any enemy units it can repair one friendly non-*altitude* *vehicle* within 3”. That unit may immediately take an attrition test.</description>
        </rule>
        <rule name="Tunnelers" id="9d81-0cc6-b5bc-717f" hidden="false">
          <description>During deployment, you can select one *troops* unit numbering ten models or less (or a group including such a unit) in the same warband as tunnelers.
When a unit with this ability deploys from reserve, the tunnelers must deploy simultaneously wholly within 6” of this unit as if they were a *vanguard* unit.</description>
        </rule>
      </rules>
      <categoryLinks>
